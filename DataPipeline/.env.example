# Copy this file to .env and fill in values. Never commit the real .env file.

# S3 location where retail-spark-pipeline writes its pipeline_status logs
# (used by GET /api/v1/pipeline/status). Only needs to match the bucket/region
# retail-spark-pipeline/.env is configured with.
AWS_REGION=us-east-1
S3_BUCKET=retail-data-lake-dev-<your-account-id>
